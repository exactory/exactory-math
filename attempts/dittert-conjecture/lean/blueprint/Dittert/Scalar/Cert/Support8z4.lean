  norm_num
  linear_combination (256 : ℝ) * hP x - hR x + hG x

theorem positive (x : ℝ) (hx : 0 ≤ x) (hx1 : x ≤ 1) : 0 < certificate x := by
  have hy : 0 ≤ 1 - x := sub_nonneg.mpr hx1
  by_cases hlt : x < 1
  · have hyp : 0 < 1 - x := sub_pos.mpr hlt
    unfold certificate C0 C1 C2 C3 C4 C5 C6 C7 C8
    positivity
  · have heq : x = 1 := le_antisymm hx1 (le_of_not_gt hlt)
    subst x
    norm_num [certificate, C0, C1, C2, C3, C4, C5, C6, C7, C8]

theorem support_certificate (u : ℝ) (hu : (1 / 400 : ℝ) ≤ u) (hu1 : u ≤ (1 / 20 : ℝ)) :
    0 < NearZero.support 8 4 u := by
  have hx : 0 ≤ (u - (1 / 400 : ℝ)) / (19 / 400 : ℝ) := by
    apply div_nonneg <;> linarith
  have hx1 : (u - (1 / 400 : ℝ)) / (19 / 400 : ℝ) ≤ 1 := by
    rw [div_le_one (by norm_num)]; linarith
  have hp := positive _ hx hx1
  rw [← identity] at hp
  have hid : uu ((u - (1 / 400 : ℝ)) / (19 / 400 : ℝ)) = u := by unfold uu; ring
  rw [hid] at hp
  exact hp

end Support8z4
