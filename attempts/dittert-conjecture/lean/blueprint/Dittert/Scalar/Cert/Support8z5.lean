theorem hC0 (x : ℝ) : C0 x = D0 x := by
  unfold C0 D0; ring
theorem hC1 (x : ℝ) : C1 x = D1 x := by
  unfold C1 D1; ring
theorem hC2 (x : ℝ) : C2 x = D2 x := by
  unfold C2 D2; ring
theorem hC3 (x : ℝ) : C3 x = D3 x := by
  unfold C3 D3; ring
theorem hC4 (x : ℝ) : C4 x = D4 x := by
  unfold C4 D4; ring
theorem hC5 (x : ℝ) : C5 x = D5 x := by
  unfold C5 D5; ring
theorem hC6 (x : ℝ) : C6 x = D6 x := by
