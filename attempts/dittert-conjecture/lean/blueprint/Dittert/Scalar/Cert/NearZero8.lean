theorem identity8 (x : ℝ) : p 8 (x/400) = certificate8 x := by
  norm_num [p, gamma, lower, kappa, e, h, t, f, Nat.factorial, certificate8]
  ring

theorem positive8 (x : ℝ) (hx : 0 ≤ x) (hx1 : x ≤ 1) :
    0 < certificate8 x := by
  have hy : 0 ≤ 1-x := sub_nonneg.mpr hx1
  by_cases hlt : x < 1
  · have hyp : 0 < 1-x := sub_pos.mpr hlt
    unfold certificate8
    positivity
  · have heq : x = 1 := le_antisymm hx1 (le_of_not_gt hlt)
    subst x
    norm_num [certificate8]

