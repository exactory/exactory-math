theorem gamma_val : NearZero.gamma 9 = (4480 / 4782969 : ℝ) := by
  unfold NearZero.gamma; norm_num [Nat.factorial]
theorem floor_val : NearZero.supportFloor 9 7 = (4698312815 / 4947802324992 : ℝ) := by
  unfold NearZero.supportFloor; simp only [show (9 : ℕ) ≠ 8 by decide, if_false]
  norm_num [NearZero.lower, NearZero.kappa, NearZero.gamma, Nat.factorial]

theorem hE (x : ℝ) : NearZero.e 9 (uu x) = E x := by
  unfold NearZero.e uu E; rw [gamma_val]; ring
theorem hH (x : ℝ) : NearZero.h 9 (uu x) = H x := by
  unfold NearZero.h uu H; rw [gamma_val]; ring
theorem hT (x : ℝ) : NearZero.t 9 (uu x) = T x := by
  unfold NearZero.t T; rw [hE, hH]; unfold E H; norm_num; ring
theorem hQ (x : ℝ) : NearZero.q 9 (uu x) = Qp x := by
  unfold NearZero.q; rw [hE, hT, gamma_val]; unfold E T Qp; norm_num; ring
theorem hV (x : ℝ) : 1 - uu x = V x := by
  unfold uu V; ring
theorem hW (x : ℝ) : NearZero.w 9 7 (uu x) = W x := by
  unfold NearZero.w; rw [hQ, hE]; unfold uu Qp E W; norm_num; ring
theorem hS (x : ℝ) : NearZero.s 9 7 (uu x) = S x := by
  unfold NearZero.s; rw [hE, hH, hT, hV, gamma_val, floor_val]; unfold E H T V S; norm_num; ring
theorem hQpow (x : ℝ) : (Qp x)^8 = Qpow x := by
  unfold Qp Qpow; ring
theorem hP (x : ℝ) : Qpow x * S x = P x := by
  unfold Qpow S P; ring
theorem hEpow (x : ℝ) : (E x)^17 = Epow x := by
  unfold E Epow; ring
theorem hWpow (x : ℝ) : (W x)^7 = Wpow x := by
  unfold W Wpow; ring
theorem hR (x : ℝ) : V x * Epow x * Wpow x = R x := by
  unfold V Epow Wpow R; ring

