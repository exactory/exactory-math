theorem hG (x : ℝ) : (823543 : ℝ) * P x - R x = certificate x := by
  unfold certificate; rw [hC0, hC1, hC2, hC3, hC4, hC5, hC6, hC7, hC8, hC9, hC10]; unfold P R D0 D1 D2 D3 D4 D5 D6 D7 D8 D9 D10; ring

theorem identity (x : ℝ) : NearZero.support 9 7 (uu x) = certificate x := by
  unfold NearZero.support
  rw [hQ, hS, hV, hE, hW, hQpow, hEpow, hWpow]
  norm_num
  linear_combination (823543 : ℝ) * hP x - hR x + hG x

theorem positive (x : ℝ) (hx : 0 ≤ x) (hx1 : x ≤ 1) : 0 < certificate x := by
