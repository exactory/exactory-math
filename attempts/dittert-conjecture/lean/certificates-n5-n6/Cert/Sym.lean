import Cert.Core

/-!
# Symmetry-adapted certificate checking, independent of `n`

Everything here takes the dimension, the generators and the certificate data as arguments, so
one copy serves every `n`.  Two positive-semidefiniteness routes live side by side.

* The **exact route**, `choleskyCertifies`.  An integer Cholesky factor `N` of
  `F^2 (A + d J) - delta I` is computed with truncating division, so `N N^T` is only close to
  it; the certificate is that the residual `E = F^2 (A + d J) - N N^T` is diagonally dominant
  with non-negative diagonal.  Then `E >= 0` by Gershgorin and `N N^T >= 0`, so `A + d J >= 0`,
  and with `A . 1 = 0` that gives `A >= 0`.  Every step is over the integers.

* The **verified floating-point route**, `floatPD`.  A floating-point Cholesky of
  `Af + d - alpha I` that runs to completion gives `M + Delta = Lc Lc^T` with
  `|Delta| <= gamma_{m+1} |Lc| |Lc^T|` (Higham, *Accuracy and Stability of Numerical
  Algorithms*, 2nd ed., Thm 10.3), so the spectral norm of `Delta` is at most
  `gamma_{m+1} sum Lc^2`.  Adding the rounding of `Af` itself gives the bound `err` below, with
  a factor of 10 of safety, and `alpha > err` proves `Af + d J` positive definite.  It is the
  route the `n = 6` main Gram needs: at 8436 x 8436 the exact route costs about 3e11
  big-integer operations and three 71-million-entry integer arrays.

Adding `d J` rather than deleting a row and column is what keeps the margin comfortable.
`A . 1 = 0`, so `lambda_min(A + d J) = min(lambda_2(A), d * dim)`, while deleting a row costs a
factor of `dim` in conditioning.
-/

namespace Cert

/-- The permutation of degree-`k` monomial indices induced by a permutation of the `nv` cells. -/
def actIdx (nv k : Nat) (mons : Array (Array Nat)) (g : Array Nat) : Array Nat :=
  mons.map (fun m => actRank nv k g m)

def inverse (p : Array Nat) : Array Nat := Id.run do
  let mut q : Array Nat := Array.replicate p.size 0
  for i in [0:p.size] do
    q := q.set! (p[i]!) i
  return q

/-- Orbit index of every ordered pair of monomial indices under the group generated by `perms`
and their inverses, numbered 0, 1, 2, ... in increasing order of the least pair in each orbit
(the order the certificate data uses), with the orbit count.  Flood fill: each pair is visited
once. -/
partial def pairOrbitIndex (dim : Nat) (perms : Array (Array Nat)) : Array Nat × Nat := Id.run do
  let all := perms ++ perms.map inverse
  let n2 := dim * dim
  let unset := n2 + 1
  let mut lab : Array Nat := Array.replicate n2 unset
  let mut cnt : Nat := 0
  for t in [0:n2] do
    if lab[t]! == unset then
      let id := cnt
      cnt := cnt + 1
      lab := lab.set! t id
      let mut stack : Array Nat := #[t]
      while stack.size > 0 do
        let s := stack.back!
        stack := stack.pop
        let a := s / dim
        let b := s % dim
        for p in all do
          let u := p[a]! * dim + p[b]!
          if lab[u]! == unset then
            lab := lab.set! u id
            stack := stack.push u
  return (lab, cnt)

/-- The integer Gram matrix from the orbit values, flat, row major. -/
def gram (dim : Nat) (idx : Array Nat) (vals : Array Int) : Array Int :=
  (Array.range (dim * dim)).map (fun t => vals[idx[t]!]!)

/-- Symmetry and `A . 1 = 0` read straight off the orbit index, so the `dim x dim` integer
matrix is never materialised.  At `n = 6` that array would hold 71 million entries. -/
def isSymmetricZeroSumIdx (dim : Nat) (idx : Array Nat) (vals : Array Int) : Bool := Id.run do
  let mut ok := true
  for i in [0:dim] do
    let mut s : Int := 0
    for j in [0:dim] do
      s := s + vals[idx[i * dim + j]!]!
      -- the values, not the orbit indices: (i, j) and (j, i) can lie in different orbits
      if vals[idx[i * dim + j]!]! != vals[idx[j * dim + i]!]! then ok := false
    if s != 0 then ok := false
  return ok

def isSymmetricZeroSum (dim : Nat) (A : Array Int) : Bool := Id.run do
  let mut ok := true
  for i in [0:dim] do
    let mut s : Int := 0
    for j in [0:dim] do
      s := s + A[i * dim + j]!
      if A[i * dim + j]! != A[j * dim + i]! then ok := false
    if s != 0 then ok := false
  return ok

/-! ### The exact route -/

def isqrt (x : Int) : Int :=
  if x ≤ 0 then 0 else Int.ofNat (Nat.sqrt x.toNat)

/-- Lower-triangular integer Cholesky factor of `Bd` (flat, row major, `dim x dim`). -/
def intCholesky (dim : Nat) (Bd : Array Int) : Option (Array Int) := Id.run do
  let mut N : Array Int := Array.replicate (dim * dim) 0
  for i in [0:dim] do
    let mut s : Int := Bd[i * dim + i]!
    for k in [0:i] do
      let v := N[i * dim + k]!
      s := s - v * v
    if s ≤ 0 then return none
    let nii := isqrt s
    if nii == 0 then return none
    N := N.set! (i * dim + i) nii
    for j in [i + 1:dim] do
      let mut t : Int := Bd[j * dim + i]!
      for k in [0:i] do
        t := t - N[j * dim + k]! * N[i * dim + k]!
      N := N.set! (j * dim + i) (t / nii)     -- truncating; any rounding is fine
  return some N

/-- `E := F^2 (A + d J) - N N^T` is diagonally dominant with non-negative diagonal. -/
def choleskyCertifies (dim : Nat) (A : Array Int) (d F delta : Int) : Bool := Id.run do
  let f2 := F * F
  let mut Bd : Array Int := Array.replicate (dim * dim) 0
  for i in [0:dim] do
    for j in [0:dim] do
      let v := f2 * (A[i * dim + j]! + d) - (if i == j then delta else 0)
      Bd := Bd.set! (i * dim + j) v
  match intCholesky dim Bd with
  | none => return false
  | some N =>
    let mut ok := true
    for i in [0:dim] do
      let mut diag : Int := 0
      let mut off : Int := 0
      for j in [0:dim] do
        let mut s : Int := 0
        let m := min i j
        for k in [0:m + 1] do
          s := s + N[i * dim + k]! * N[j * dim + k]!
        let e := f2 * (A[i * dim + j]! + d) - s
        if i == j then diag := e else off := off + e.natAbs
      if diag < off then ok := false
    return ok

/-! ### The verified floating-point route -/

/-- Correctly rounded conversion.  At `n = 6` the orbit values reach `2.5e16`, above `2^53`, so
this rounds; the division by `den` rounds again.  Both are covered by the `3 u ||Af||_F` term of
`highamBound`, which is how `check_verified.py` accounts for the same two roundings. -/
def intToFloat (x : Int) : Float :=
  if x < 0 then -(Float.ofNat x.natAbs) else Float.ofNat x.natAbs

/-- The shifted matrix `Af + d - alpha I` as a packed array of doubles, together with the
Frobenius norm and the largest absolute entry of the unshifted `Af`. -/
def buildShifted (dim : Nat) (idx : Array Nat) (vals : Array Int) (den d alpha : Float) :
    FloatArray × Float × Float := Id.run do
  let scaled := vals.map (fun v => intToFloat v / den)
  let mut M : FloatArray := FloatArray.mk (Array.replicate (dim * dim) 0.0)
  let mut sq : Float := 0.0
  let mut mx : Float := 0.0
  for i in [0:dim] do
    for j in [0:dim] do
      let t := i * dim + j
      let a := scaled[idx[t]!]!
      sq := sq + a * a
      let aa := a.abs
      if aa > mx then mx := aa
      M := M.set! t (a + d - (if i == j then alpha else 0.0))
  return (M, sq.sqrt, mx)

/-- Column-oriented Cholesky in place; returns the sum of the squares of the factor's entries,
or `none` when a pivot is not positive. -/
def floatCholeskySumSq (dim : Nat) (M0 : FloatArray) : Option Float := Id.run do
  let mut A := M0
  let mut sumsq : Float := 0.0
  for j in [0:dim] do
    let mut s := A.get! (j * dim + j)
    for k in [0:j] do
      let v := A.get! (j * dim + k)
      s := s - v * v
    if s ≤ 0.0 then return none
    let ljj := s.sqrt
    A := A.set! (j * dim + j) ljj
    sumsq := sumsq + ljj * ljj
    for i in [j + 1:dim] do
      let mut t := A.get! (i * dim + j)
      for k in [0:j] do
        t := t - A.get! (i * dim + k) * A.get! (j * dim + k)
      let lij := t / ljj
      A := A.set! (i * dim + j) lij
      sumsq := sumsq + lij * lij
  return some sumsq

/-- Higham's rigorous bound, with a factor of 10 of safety. -/
def highamBound (dim : Nat) (sumL2 frob mx : Float) : Float :=
  let u : Float := 1.1102230246251565e-16      -- 2^-53
  let m := Float.ofNat (dim + 1)
  let gam := m * u / (1.0 - m * u)
  10.0 * (gam * sumL2 + 3.0 * u * frob + m * u * mx)

/-- `A / den + d J` is positive definite: a floating-point Cholesky of `Af + d - alpha I` ran to
completion and `alpha` exceeds Higham's bound on the backward error. -/
def floatPD (dim : Nat) (idx : Array Nat) (vals : Array Int) (den d alpha : Float) : Bool :=
  let (M, frob, mx) := buildShifted dim idx vals den d alpha
  match floatCholeskySumSq dim M with
  | none => false
  | some sumL2 => alpha > highamBound dim sumL2 frob mx

end Cert
